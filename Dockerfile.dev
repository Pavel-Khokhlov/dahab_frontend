# Dockerfile.dev - для разработки с hot-reload
FROM node:24-alpine

WORKDIR /app

# Копируем package файлы для установки зависимостей
COPY package*.json ./
RUN npm ci

# Копируем остальные файлы
COPY . .

# Открываем порт Vite (обычно 5173)
EXPOSE 5173

# Запускаем dev сервер с hot-reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]